#!/bin/bash
# omarchy:group=install
# omarchy:name=cctv-lite
# omarchy:summary=Install CCTV Lite (Omarchy RTSP viewer) into ~/.local.
# omarchy:examples=omarchy install cctv-lite
# omarchy:aliases=omarchy-install-cctv-lite

set -euo pipefail

PREFIX="${CCTV_LITE_PREFIX:-$HOME/.local}"
REPO="${CCTV_LITE_REPO:-cytracon/cctv-lite}"
WEB="https://github.com/${REPO}"

log() { printf '\033[36m[cctv-lite]\033[0m %s\n' "$*"; }
ok()  { printf '\033[32m[cctv-lite]\033[0m %s\n' "$*"; }
err() { printf '\033[31m[cctv-lite]\033[0m %s\n' "$*" >&2; }
die() { err "$*"; exit 2; }

HERE="$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

find_installer() {
  local f
  for f in \
    "${HERE}/../install-local.sh" \
    "${PREFIX}/share/cctv-lite/install-local.sh" \
    "${HERE}/install-local.sh"
  do
    [[ -f "$f" ]] && { echo "$f"; return 0; }
  done
  return 1
}

ensure_sources() {
  if src="$(find_installer)"; then
    ROOT="$(cd "$(dirname "$src")" && pwd)"
    echo "$ROOT"
    return 0
  fi
  command -v git >/dev/null 2>&1 || die "git is required to clone ${REPO}"
  mkdir -p "${PREFIX}/share"
  tmp="$(mktemp -d)"
  log "Cloning ${WEB}…"
  git clone --depth 1 "https://github.com/${REPO}.git" "$tmp/cctv-lite" || {
    rm -rf "$tmp"
    die "Clone failed: ${WEB}"
  }
  echo "$tmp/cctv-lite"
}

install_omarchy_cli() {
  mkdir -p "${PREFIX}/bin"
  src="${HERE}/omarchy-install-cctv-lite"
  dest="${PREFIX}/bin/omarchy-install-cctv-lite"
  if [[ -f "$src" && "$(readlink -f "$src")" != "$(readlink -f "$dest" 2>/dev/null || true)" ]]; then
    cp -f "$src" "$dest"
    chmod 755 "$dest"
  fi
  wrap="${HERE}/../omarchy/omarchy-user-cli"
  if [[ -f "$wrap" ]]; then
    cp -f "$wrap" "${PREFIX}/bin/omarchy"
    chmod 755 "${PREFIX}/bin/omarchy"
  elif [[ -x "${PREFIX}/bin/omarchy" ]]; then
    :
  fi
}

main() {
  case "${1:-}" in
    -h|--help)
      cat <<'EOF'
Usage: omarchy install cctv-lite

Install CCTV Lite into ~/.local. User config stays in ~/.config/cctv-lite/.
EOF
      exit 0
      ;;
  esac

  log "CCTV Lite for Omarchy"
  install_omarchy_cli
  ROOT="$(ensure_sources)"
  bash "$ROOT/install-local.sh"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g 󰄀 "CCTV Lite installed" "Launch from the bar plugin or run cctv-lite" || true
  fi
  ok "Fertig. Start: cctv-lite"
  ok "Bar plugin enabled with the install."
  ok "Docs: ${WEB}"
}

main "$@"
